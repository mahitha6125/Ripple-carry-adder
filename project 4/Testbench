`timescale 1ns/1ps

module shift_register_tb;

reg clk;
reg reset;
reg serial_in;
wire serial_out;

shift_register uut(
    .clk(clk),
    .reset(reset),
    .serial_in(serial_in),
    .serial_out(serial_out)
);

always #5 clk = ~clk;

initial
begin
    clk = 0;
    reset = 1;
    serial_in = 0;

    #10 reset = 0;

    #10 serial_in = 1;
    #10 serial_in = 0;
    #10 serial_in = 1;
    #10 serial_in = 1;
    #10 serial_in = 0;

    #30 $finish;
end

initial
begin
    $monitor("Time=%0t Reset=%b Serial_In=%b Shift_Register=%b Serial_Out=%b",
             $time, reset, serial_in, uut.shift_reg, serial_out);
end

endmodule